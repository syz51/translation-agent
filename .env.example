TA_PG_DB=translation_agent
TA_PG_USER=translation_agent
TA_PG_PASSWORD=translation_agent
TA_PG_PORT=55432

TA_DATA_DIR=.translation-agent
TA_ADAPTER_MODE=fake
TA_STATE_DB_DSN=postgresql://translation_agent:translation_agent@127.0.0.1:55432/translation_agent
TA_DEFAULT_SOURCE_LANGUAGE=en
TA_DEFAULT_TARGET_LANGUAGE=zh

# Real-mode translation defaults to Gemini through the OpenAI-compatible endpoint.
TA_TRANSLATION_PROVIDER=gemini
TA_TRANSLATION_MODEL_ID=gemini-2.5-flash
TA_GEMINI_API_KEY=
TA_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Reasoning is configured separately for future live review/judge integrations.
TA_REASONING_PROVIDER=openai
TA_REASONING_MODEL_ID=gpt-5.4
TA_OPENAI_API_KEY=
TA_OPENAI_BASE_URL=
